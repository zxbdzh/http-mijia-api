# Server Configuration
MIJIA_HOST=0.0.0.0
MIJIA_PORT=8080
MIJIA_DEBUG=false
MIJIA_LOG_LEVEL=INFO

# Data Directory
MIJIA_DATA_DIR=./data

# API Secret (optional) - leave empty to disable authentication
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
MIJIA_API_SECRET=

# CORS Origins (comma-separated, use * for all)
MIJIA_CORS_ORIGINS=*
